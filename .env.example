# DATABASE (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password123@postgres-db:5432/comic_db?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CLOUDFLARE R2 / AWS S3 COMPATIBLE STORAGE
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=comic-assets
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com

# TRANSLATION AI ENGINE
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# CRON & API SECURITY
CRON_SECRET_TOKEN=super-secret-cron-bearer-token-32char
PORT=3000
PYTHONUNBUFFERED=1
